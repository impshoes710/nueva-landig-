# Dominio de la tienda Shopify (sin https)
# Ejemplo: tu-tienda.myshopify.com
SHOPIFY_STORE_DOMAIN=calzadoselite.myshopify.com

# Token de Admin API con permisos write_orders (y read_products)
# Crear en: Shopify Admin → Configuración → Apps → Desarrollar apps
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxx

# Opcional — versión de la API Admin
SHOPIFY_API_VERSION=2024-10

---
import type { ProductData } from '../../config/product-data';

interface Props {
  data: ProductData;
}
const { data } = Astro.props;
const t = data.tiktok;
---

<section class="mx-auto max-w-6xl px-4 py-14 lg:px-6" id="tiktok">
  <h2 class="text-center text-2xl font-bold md:text-3xl">{t.titulo}</h2>
  <p class="mt-1 text-center text-[var(--premium-muted)]">{t.subtitulo}</p>
  <div class="mt-8 grid grid-cols-2 gap-3 md:gap-4">
    {
      t.videos.map((v) => (
        <div class="relative aspect-[9/16] overflow-hidden rounded-2xl bg-black ring-1 ring-white/10">
          <video
            src={v.url}
            class="h-full w-full object-cover"
            controls
            playsinline
            preload="metadata"
          />
          {v.views && (
            <span class="absolute left-2 top-2 rounded-lg bg-black/70 px-2 py-1 text-xs font-medium">
              {v.views}
            </span>
          )}
        </div>
      ))
    }
  </div>
  <p class="mt-6 text-center text-sm text-[var(--premium-muted)]">{t.caption}</p>
</section>

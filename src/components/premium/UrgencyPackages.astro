---
import type { ProductData } from '../../config/product-data';
import { packageDiscount } from '../../lib/format';

interface Props {
  data: ProductData;
}
const { data } = Astro.props;
const pkg1 = data.paquetes[0];
const pkg2 = data.paquetes[1] ?? pkg1;
const disc1 = packageDiscount(pkg1.comparePrice, pkg1.price);
const disc2 = packageDiscount(pkg2.comparePrice, pkg2.price);
const u = data.urgencia;
const stockPct = Math.round((u.stockRestante / u.stockTotal) * 100);
---

<section class="mx-auto max-w-6xl px-4 py-14 lg:px-6" id="oferta">
  {u.activo && (
    <div class="premium-glass mb-8 rounded-2xl p-5">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h2 class="text-lg font-bold">{u.titulo}</h2>
        <p class="font-mono text-sm text-[var(--premium-accent)]">
          <span id="countdown-display">00:00:00</span>
        </p>
      </div>
      <div class="mt-4 h-2 overflow-hidden rounded-full bg-white/10">
        <div
          id="stock-progress"
          class="h-full rounded-full bg-[var(--premium-accent)] transition-all duration-700"
          style={`width:${stockPct}%`}
        />
      </div>
      <p class="mt-2 text-sm text-[var(--premium-muted)]">
        Solo <strong id="stock-count" class="text-[var(--premium-text)]">{u.stockRestante}</strong> pares en esta oferta
      </p>
      <ul class="mt-3 space-y-1 text-sm text-[var(--premium-muted)]">
        {u.mensajes.map((m) => <li>{m}</li>)}
      </ul>
    </div>
  )}

  <div class="grid gap-3 md:grid-cols-2">
    {
      data.paquetes.map((pkg, i) => (
        <div
          class:list={[
            'package-card cursor-pointer rounded-2xl border p-5 transition',
            i === 0
              ? 'border-[var(--premium-accent)] bg-[var(--premium-accent)]/10'
              : 'border-white/10 bg-[var(--premium-surface)] hover:border-white/20',
          ]}
          data-package-index={i}
        >
          <div class="flex items-center gap-4">
            <div class="shrink-0 package-icon">
              {i === 0 ? (
                <div class="flex h-5 w-5 items-center justify-center rounded-full bg-[var(--premium-accent)]">
                  <svg class="h-3 w-3 text-white" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
                    <path d="M20 6 9 17l-5-5" />
                  </svg>
                </div>
              ) : (
                <svg class="h-5 w-5 text-neutral-500" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                  <circle cx="12" cy="12" r="10" />
                </svg>
              )}
            </div>
            <div class="min-w-0 flex-1">
              <p class="font-semibold text-md">{pkg.label}</p>
              <p class="text-sm text-[var(--premium-muted)]">{pkg.subtitle}</p>
            </div>
            <div class="text-right">
              <p class="text-sm text-[var(--premium-muted)] line-through">{pkg.comparePrice}</p>
              <p class="text-xl font-bold text-[var(--premium-accent)]">{pkg.price}</p>
            </div>
          </div>
        </div>
      ))
    }
  </div>

  <div class="premium-glass mt-6 rounded-2xl p-5">
    <div class="flex justify-between text-sm">
      <span class="text-[var(--premium-muted)]">Subtotal</span>
      <span id="summary-subtotal" class="font-semibold">{pkg1.comparePrice}</span>
    </div>
    <div class="mt-2 flex justify-between text-sm">
      <span class="text-[var(--premium-muted)]">Descuento</span>
      <span id="summary-discount" class="font-semibold text-[var(--premium-accent)]">-{disc1}</span>
    </div>
    <div class="mt-4 flex items-center justify-between border-t border-white/10 pt-4">
      <span class="text-lg font-bold">Total</span>
      <div class="flex items-center gap-2">
        <span id="summary-total" class="text-2xl font-bold">{pkg1.price}</span>
        <span
          id="summary-percent"
          class="rounded-md bg-[var(--premium-accent)] px-2 py-0.5 text-xs font-bold text-[var(--premium-accent-fg)]"
        >
          {pkg1.percent}%
        </span>
      </div>
    </div>
  </div>
</section>

<!-- data attrs for checkout scripts -->
<div
  id="landing-root"
  class="hidden"
  data-product-name={data.nombre}
  data-package1-total={pkg1.price}
  data-package1-compare={pkg1.comparePrice}
  data-package1-discount={disc1}
  data-package1-percent={pkg1.percent}
  data-package2-total={pkg2.price}
  data-package2-compare={pkg2.comparePrice}
  data-package2-discount={disc2}
  data-package2-percent={pkg2.percent}
  data-countdown-hours={u.horasContador}
  data-stock-restante={u.stockRestante}
/>

---
import type { ProductData } from '../../config/product-data';
import { formatPrecio } from '../../lib/format';

interface Props {
  data: ProductData;
}
const { data } = Astro.props;
---

<div
  id="sticky-bar"
  class="premium-sticky-bar fixed inset-x-0 bottom-0 z-40 border-t border-white/10 bg-[var(--premium-bg)]/95 p-3 backdrop-blur-lg lg:hidden"
>
  <div class="mx-auto flex max-w-lg items-center gap-3">
    <div class="min-w-0 flex-1">
      <p class="truncate text-sm font-semibold">{data.nombre}</p>
      <p class="text-lg font-bold text-[var(--premium-accent)]">
        {formatPrecio(data.precio, data.moneda)}
      </p>
    </div>
    <button
      type="button"
      data-checkout-open
      class="shrink-0 rounded-xl bg-[var(--premium-accent)] px-5 py-3 text-sm font-bold text-[var(--premium-accent-fg)]"
    >
      {data.cta.secundario}
    </button>
  </div>
</div>

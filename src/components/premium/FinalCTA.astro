---
import type { ProductData } from '../../config/product-data';
import { formatPrecio } from '../../lib/format';

interface Props {
  data: ProductData;
}
const { data } = Astro.props;
const cta = data.ctaFinal;
---

<section class="mx-auto max-w-3xl px-4 py-16 text-center lg:px-6" id="cta-final">
  <h2 class="text-3xl font-bold md:text-4xl">{cta.titulo}</h2>
  <p class="mt-3 text-lg text-[var(--premium-muted)]">{cta.subtitulo}</p>
  <p class="mt-4 text-2xl font-bold text-[var(--premium-accent)]">
    {formatPrecio(data.precio, data.moneda)}
  </p>
  <button
    type="button"
    data-checkout-open
    class="premium-cta-pulse mt-8 inline-flex min-w-[280px] items-center justify-center rounded-2xl bg-[var(--premium-accent)] px-10 py-5 text-lg font-bold text-[var(--premium-accent-fg)] shadow-xl transition hover:scale-[1.02]"
  >
    {cta.boton}
  </button>
</section>

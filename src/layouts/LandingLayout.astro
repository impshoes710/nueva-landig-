---
import headContentDefault from '../partials/head-content.html?raw';
import headContentCadense from '../partials/head-content-cadense.html?raw';
import galleryConfig from '../data/cadense-gallery.json';
import CheckoutModal from '../components/CheckoutModal.astro';
import '../styles/buttons-black.css';

interface Props {
  head?: 'cadense';
}

const { head } = Astro.props;
const isCadense = head === 'cadense';
const headContent = isCadense ? headContentCadense : headContentDefault;
---

<!doctype html>
<html lang="es">
  <head>
    <Fragment set:html={headContent} />
  </head>
  <body>
    {isCadense && (
      <script
        type="application/json"
        id="cadense-gallery-config"
        set:html={JSON.stringify(galleryConfig)}
      />
    )}
    <slot />
    <CheckoutModal />
    {isCadense && (
      <script>
        import '../scripts/cadense-gallery.js';
      </script>
    )}
    <script>
      import '../scripts/checkout-modal.js';
    </script>
  </body>
</html>

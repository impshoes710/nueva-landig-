---
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingPage from '../components/landing/LandingPage.astro';
import { loadLandingConfig } from '../lib/landing-config';

const config = await loadLandingConfig();
---

<LandingLayout title={config.meta.title} description={config.meta.description} accent={config.theme.accent}>
  <LandingPage config={config} />
</LandingLayout>
